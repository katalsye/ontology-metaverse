<!-- ============================================
     1-1. SplashScreen.uxml — 스플래시 화면
     앱 실행 시 첫 화면. 로고 + 앱 이름 + 로딩 표시
     ============================================ -->
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <!-- 스타일시트 연결 -->
    <Style src="../../Styles/AppTokens.uss" />
    <Style src="../../Styles/AppComponents.uss" />
    <Style src="SplashScreen.uss" />

    <!-- 루트 컨테이너: 전체 화면, 그라데이션 배경 -->
    <ui:VisualElement name="splash-root" class="full-screen center-content col">

        <!-- 로고 영역 -->
        <ui:VisualElement name="logo-container" class="center-content">
            <!-- 외부 링: conic gradient 효과 (USS에서 처리) -->
            <ui:VisualElement name="logo-ring" class="center-content">
                <!-- 내부 원: 흰색 배경 -->
                <ui:VisualElement name="logo-inner" class="center-content">
                    <!-- 아이콘 이미지 (Sprite 할당 필요) -->
                    <ui:VisualElement name="logo-icon" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 앱 이름 -->
        <ui:Label name="app-name" text="마이룸" class="text-hero" />

        <!-- 서브타이틀 -->
        <ui:Label name="app-subtitle" text="나만의 공간, 자동으로 채워지는 일상"
                  class="text-caption" />

        <!-- 로딩 영역 -->
        <ui:VisualElement name="loading-area" class="center-content col">
            <!-- 스피너 (C# 스크립트로 회전 애니메이션) -->
            <ui:VisualElement name="spinner" />
            <ui:Label name="loading-text" text="로딩 중..." class="text-tiny" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
