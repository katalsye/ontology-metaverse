<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:dist="http://schemas.android.com/apk/distribution" package="com.ontology.metaverse" android:versionCode="1" android:versionName="1.0">
  <!-- FCM 푸시 알림 권한 -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
  <!-- 자동 데이터 수집 권한 (P3c) -->
  <!-- 위치: LocationCollector — GPS 좌표 수집해서 장소 방문 패턴 추론용 -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- 백그라운드 위치: 앱 화면 끄고도 수집하려면 필요. 일단 포그라운드만 쓸 거라 생략. -->
  <!-- 신체 활동: StepCollector — 걸음수 카운터(Android 4.4+) -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <!-- 갤러리 사진: GalleryEXIFCollector — Android 13+ 세분화 권한 -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <!-- Android 12 이하 폴백 (Target 36이라 13+ 위주지만 호환성용) -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- 앱 사용시간: AppUsageCollector — UsageStatsManager 접근
       이건 일반 권한 아니라 시스템 설정에서 사용자가 수동 허용해야 함.
       (Settings.ACTION_USAGE_ACCESS_SETTINGS 인텐트로 유도) -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- 인터넷 (Firestore 통신) -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- 캘린더: CalendarCollector — 로컬 캘린더(Google/Samsung 동기화 포함) ContentResolver 조회
       Android 9+ runtime permission. Java CalendarHelper.java가 사용. -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <!-- ────────────────────────────────────────────────────── -->
  <!-- Health Connect 권한 (P4: HealthConnectCollector)
       androidx.health.connect:connect-client SDK가 요구하는 권한들.
       각 permission은 Health Connect 앱(com.google.android.apps.healthdata)에서
       사용자가 명시적으로 grant 해야 함. requestPermissions() 호출 시 redirect 됨. -->
  <uses-permission android:name="android.permission.health.READ_SLEEP" />
  <uses-permission android:name="android.permission.health.READ_STEPS" />
  <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
  <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
  <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
  <uses-permission android:name="android.permission.health.READ_EXERCISE" />
  <!-- Health Connect 앱 visibility (Android 11+ 패키지 가시성 제한 회피) -->
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
    <intent>
      <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
    </intent>
  </queries>
  <application android:label="@string/app_name" android:icon="@drawable/app_icon" android:allowBackup="false">
    <!-- The MessagingUnityPlayerActivity is a class that extends
         UnityPlayerActivity to work around a known issue when receiving
         notification data payloads in the background. -->
    <activity android:name="com.google.firebase.MessagingUnityPlayerActivity" android:theme="@style/BaseUnityGameActivityTheme" android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
    </activity>
    <service android:name="com.google.firebase.messaging.MessageForwardingService" android:exported="false" tools:replace="android:exported" />
    <!-- Health Connect 권한 rationale Activity (Android 13 / API 33 방식):
         사용자가 Health Connect 권한 화면에서 "이 앱은 왜 데이터가 필요한지?" 클릭 시 표시.
         메인 Activity로 라우팅 (Unity 표준 패턴). -->
    <activity-alias android:name="com.ontology.metaverse.HealthConnectPermissionsRationale" android:exported="true" android:targetActivity="com.google.firebase.MessagingUnityPlayerActivity">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity-alias>
    <!-- Health Connect 권한 rationale Activity (Android 14+ / API 34+ 방식 — 필수):
         Android 14+ 통합형 Health Connect는 권한 요청 시 앱이 이 ViewPermissionUsageActivity를
         선언했는지 검사한다. 없으면 정책상 권한 화면을 띄우지 않고 즉시 빈 결과(grant [])로 닫는다.
         삼성 S24(API 36)처럼 OS 통합형 기기에서 권한 팝업이 0.26초만에 사라지는 원인.
         android:permission=START_VIEW_PERMISSION_USAGE로 시스템만 이 alias를 호출하도록 제한. -->
    <activity-alias android:name="ViewPermissionUsageActivity" android:exported="true" android:targetActivity="com.google.firebase.MessagingUnityPlayerActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
    <!-- Spotify OAuth callback Activity (Custom URL Scheme: ontologyapp://spotify-callback).
         사용자가 Spotify 인증 페이지에서 로그인 + 권한 허용 후 이 URI로 리다이렉트됨.
         singleTask + Translucent → callback intent 받자마자 finish() 호출해 dismiss.
         Spotify Developer Dashboard의 Redirect URI에 정확히 같은 값 등록 필수. -->
    <activity android:name="com.ontology.metaverse.spotify.SpotifyCallbackActivity" android:exported="true" android:launchMode="singleTask" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="ontologyapp" android:host="spotify-callback" />
      </intent-filter>
    </activity>
  </application>
</manifest>