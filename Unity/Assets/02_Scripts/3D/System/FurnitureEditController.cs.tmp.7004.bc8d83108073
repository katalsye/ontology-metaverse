using System.Collections;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.InputSystem;
using UnityEngine.InputSystem.EnhancedTouch;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;
using DynamicWeatherSystem;
using Touch = UnityEngine.InputSystem.EnhancedTouch.Touch;

/// <summary>
/// EditMode에서 가구 선택 → 디자인 변경 / 위치 이동을 담당.
/// 씬에 하나만 배치, RoomModeManager.ApplyMode()에서 EnterEditMode() 호출.
/// </summary>
public class FurnitureEditController : MonoBehaviour
{
    public static FurnitureEditController Instance { get; private set; }

    [Header("자동 등록 — 씬 컨테이너")]
    [Tooltip("가구들의 부모 Transform — RoomData.furnitureType으로 자식을 검색해 자동 등록")]
    public Transform furnitureParent;
    [Tooltip("벽들의 부모 Transform — 자식 전체가 canMove=false, canDesign=true 로 자동 등록")]
    public Transform wallParent;

    [Header("편집 가능 가구 목록 (런타임 자동 생성 — 수동 추가도 가능)")]
    public FurnitureEditConfig[] editableItems;

    [Header("그리드")]
    public float gridCellSize = 10f;
    [Tooltip("바닥 높이 (보통 0 — 가구 Y 위치 기준)")]
    public float floorY = 0f;

    [Header("방 경계 (이 안에서만 이동 가능)")]
    public float roomMinX = -200f;
    public float roomMaxX =  100f;
    public float roomMinZ = -100f;
    public float roomMaxZ =  200f;

    [Header("카메라 고정 뷰 (Inspector에서 튜닝)")]
    public Vector3 editCamPosition = new Vector3(-50f, 90f,  80f);
    public Vector3 editCamLookAt   = new Vector3(-50f,  0f,  10f);

    [Header("선택 하이라이트")]
    public Color highlightColor = new Color(1f, 0.85f, 0f);
    [Range(0f, 1f)]
    public float highlightIntensity = 0.35f;

    [Header("조이스틱")]
    public GameObject joystickObject;

    [Header("UI — 선택 팝업 (가구 선택 시 등장)")]
    public GameObject editPopup;
    public Button designChangeBtn;
    public Button positionMoveBtn;

    [Header("UI — 이동 확인 (위치이동 모드 중)")]
    public GameObject confirmUI;
    public Button confirmBtn;
    public Button cancelBtn;
    public Button rotateCWBtn;   // 시계방향 90°
    public Button rotateCCWBtn;  // 반시계방향 90°

    [Header("UI — 가구 추가")]
    public GameObject addFurniturePanel;
    public GameObject addFurnitureBtn;   // 선택 중엔 비활성

    // ── 환경 원복용 (Start에서 1회 저장) ─────────────────────────
    private float            _origLightIntensity;
    private Color            _origLightColor;
    private AmbientMode      _origAmbientMode;
    private Color            _origAmbientLight;
    private bool             _origFog;
    private CameraClearFlags _origClearFlags;
    private Color            _origBgColor;
    private bool             _origPostProcessing;
    private Volume[]         _sceneVolumes;

    // EditMode 중 매 프레임 환경 강제 고정에 쓰는 플래그
    private bool _editModeActive = false;

    // ── 상태 ─────────────────────────────────────────────────
    private Camera      _cam;
    private GameObject  _selected;
    private Vector3     _originalPos;
    private Quaternion  _originalRot;
    private bool        _movingMode;
    private int         _dragFingerId = -1;
    private Vector3     _dragOffset;       // 손가락 바닥 위치와 가구 위치의 오프셋
    private bool        _dragOffsetInit;   // 이번 이동 모드에서 _dragOffset이 한 번이라도 잡혔는지
    private bool        _debugDrag = false;
    private bool        _isDragOverlap = false;
    void Awake()
    {
        Instance = this;
        _cam = Camera.main;

        if (joystickObject == null)
        {
            var jc = FindObjectOfType<JoystickController>();
            if (jc != null && jc.joystickArea != null)
                joystickObject = jc.joystickArea.gameObject;
        }

        if (editPopup)  editPopup.SetActive(false);
        if (confirmUI)  confirmUI.SetActive(false);

        // 씬 로드 시점에 미리 한 번 등록 (EnterEditMode 전에도 동작하도록)
        RefreshEditableItems();
    }

    void Start()
    {
        if (designChangeBtn) designChangeBtn.onClick.AddListener(OnDesignChange);
        if (positionMoveBtn) positionMoveBtn.onClick.AddListener(OnPositionMove);
        if (confirmBtn)      confirmBtn.onClick.AddListener(Confirm);
        if (cancelBtn)       cancelBtn.onClick.AddListener(Cancel);
        if (rotateCWBtn)     rotateCWBtn.onClick.AddListener(() => RotateSelected(90f));
        if (rotateCCWBtn)    rotateCCWBtn.onClick.AddListener(() => RotateSelected(-90f));

        // 원본 환경 1회 저장 — WeatherController.Start()가 DefaultExecutionOrder(100)이므로
        // 이 시점(기본 0)에는 아직 WeatherController가 Start()를 실행하기 전일 수 있음.
        // 따라서 저장은 1프레임 뒤로 미루고, EditMode가 이미 켜져 있다면 재진입.
        StartCoroutine(LateStartInit());
    }

    // WeatherController(ExecutionOrder=100)가 Start()를 마친 뒤 저장하기 위해 1프레임 대기
    IEnumerator LateStartInit()
    {
        yield return null; // 1프레임 대기

        _sceneVolumes = FindObjectsOfType<Volume>(true);

        _origAmbientMode  = RenderSettings.ambientMode;
        _origAmbientLight = RenderSettings.ambientLight;
        _origFog          = RenderSettings.fog;

        var sun = RenderSettings.sun ?? FindObjectOfType<Light>();
        if (sun != null)
        {
            _origLightIntensity = sun.intensity;
            _origLightColor     = sun.color;
        }

        if (_cam != null)
        {
            _origClearFlags = _cam.clearFlags;
            _origBgColor    = _cam.backgroundColor;
            var cd = _cam.GetComponent<UniversalAdditionalCameraData>();
            if (cd != null) _origPostProcessing = cd.renderPostProcessing;
        }

        // EditMode가 이미 요청되어 있으면 지금 다시 적용
        if (RoomModeManager.CurrentMode == RoomMode.EditMode)
            ApplyEditEnvironment();
    }

    void OnEnable()  { EnhancedTouchSupport.Enable(); }
    void OnDisable() { EnhancedTouchSupport.Disable(); }

    // ── EditMode 진입/퇴장 ────────────────────────────────────

    public void EnterEditMode()
    {
        Deselect();
        RefreshEditableItems();       // 가구·벽 자동 등록
        ComputeRoomBoundsFromWalls(); // 벽 콜라이더로 방 경계 자동 계산
        if (joystickObject != null) joystickObject.SetActive(false);
        if (_cam == null) _cam = Camera.main;

        // WeatherManager/WeatherController의 Start()가 끝난 뒤에 환경을 덮어써야 함.
        // LateStartInit 코루틴이 완료되어 있으면 바로 적용, 아니면 코루틴이 마저 처리함.
        if (_sceneVolumes != null)
            ApplyEditEnvironment();
        // else: LateStartInit 코루틴 끝에서 자동으로 적용됨

        _editModeActive = true;
    }

    // 실제 환경 설정 — WeatherManager/Controller가 덮어쓰므로 별도 메서드로 분리
    void ApplyEditEnvironment()
    {
        // WeatherManager(DWS) 비활성 — 이것이 핵심. LightModule이 매 프레임 조명을 재설정함.
        var weatherManager = FindObjectOfType<WeatherManager>();
        if (weatherManager != null) weatherManager.enabled = false;

        // WeatherController도 비활성
        var weatherController = FindObjectOfType<WeatherController>();
        if (weatherController != null) weatherController.enabled = false;

        if (_cam == null) _cam = Camera.main;
        if (_cam != null)
        {
            var cd = _cam.GetComponent<UniversalAdditionalCameraData>();
            if (cd != null) cd.renderPostProcessing = false;
            _cam.clearFlags      = CameraClearFlags.SolidColor;
            _cam.backgroundColor = new Color(0.75f, 0.75f, 0.75f);
        }

        if (_sceneVolumes != null)
            foreach (var v in _sceneVolumes) if (v != null) v.enabled = false;

        RenderSettings.ambientMode  = AmbientMode.Flat;
        RenderSettings.ambientLight = new Color(0.55f, 0.55f, 0.55f);
        RenderSettings.fog          = false;

        var sunLight = RenderSettings.sun ?? FindObjectOfType<Light>();
        if (sunLight != null)
        {
            sunLight.intensity = 0.4f;
            sunLight.color     = Color.white;
        }

        DynamicGI.UpdateEnvironment();
        _editModeActive = true;
    }

    public void ExitEditMode()
    {
        _editModeActive = false;
        Deselect();
        CancelMove();
        if (joystickObject != null) joystickObject.SetActive(true);

        // WeatherManager/Controller 복원
        var weatherManager = FindObjectOfType<WeatherManager>();
        if (weatherManager != null) weatherManager.enabled = true;

        var weatherController = FindObjectOfType<WeatherController>();
        if (weatherController != null) weatherController.enabled = true;

        // 전부 원복
        if (_cam != null)
        {
            var cd = _cam.GetComponent<UniversalAdditionalCameraData>();
            if (cd != null) cd.renderPostProcessing = _origPostProcessing;
            _cam.clearFlags      = _origClearFlags;
            _cam.backgroundColor = _origBgColor;
        }
        if (_sceneVolumes != null)
            foreach (var v in _sceneVolumes) if (v != null) v.enabled = true;

        RenderSettings.ambientMode  = _origAmbientMode;
        RenderSettings.ambientLight = _origAmbientLight;
        RenderSettings.fog          = _origFog;

        var sunLight = RenderSettings.sun ?? FindObjectOfType<Light>();
        if (sunLight != null)
        {
            sunLight.intensity = _origLightIntensity;
            sunLight.color     = _origLightColor;
        }
        DynamicGI.UpdateEnvironment();

        // WeatherController에게 현재 날씨를 재적용시켜 원래 상태로 되돌림
        if (weatherController != null)
            weatherController.SetWeather(weatherController.CurrentWeather, weatherController.CurrentTime);

    }

    // ── Update ────────────────────────────────────────────────

    void Update()
    {
        if (RoomModeManager.CurrentMode != RoomMode.EditMode) return;

        // Inspector에서 실시간 튜닝 가능하도록 매 프레임 카메라 적용
        if (_cam != null && !_movingMode)
        {
            _cam.transform.position = editCamPosition;
            _cam.transform.LookAt(editCamLookAt, Vector3.up);
            _cam.transform.Rotate(Vector3.forward, 180f, Space.Self);
        }

        if (_movingMode) HandleDrag();
    }

    // ── 가구 클릭 (CameraController에서 호출) ─────────────────

    /// <summary>EditMode에서 가구 클릭 시 CameraController가 호출</summary>
    public void OnFurnitureClicked(GameObject furniture)
    {
        if (_movingMode) return;
        if (!IsEditable(furniture)) { Deselect(); return; }
        if (_selected == furniture) { Deselect(); return; } // 이미 선택된 애 다시 누르면 해제
        SelectFurniture(furniture);
    }

    /// <summary>EditMode에서 빈 곳 클릭 시 CameraController가 호출</summary>
    public void OnEmptyClicked()
    {
        if (_movingMode) return;
        Deselect();
    }

    // ── 선택 ─────────────────────────────────────────────────

    void SelectFurniture(GameObject furniture)
    {
        if (_selected != null) SetHighlight(_selected, false);
        _selected = furniture;
        SetHighlight(furniture, true);

        var cfg = GetConfig(furniture);
        if (designChangeBtn) designChangeBtn.gameObject.SetActive(cfg?.canDesign ?? true);
        if (positionMoveBtn)  positionMoveBtn.gameObject.SetActive(cfg?.canMove   ?? true);

        if (addFurnitureBtn) addFurnitureBtn.SetActive(false);
        if (editPopup)
        {
            editPopup.SetActive(true);
            PositionPopupAbove(furniture);
        }
    }

    void Deselect()
    {
        if (_selected != null) SetHighlight(_selected, false);
        _selected = null;
        if (editPopup) editPopup.SetActive(false);
        if (addFurnitureBtn) addFurnitureBtn.SetActive(true);
    }

    // ── 하이라이트 ────────────────────────────────────────────

    void SetHighlight(GameObject go, bool show)
    {
        foreach (var r in go.GetComponentsInChildren<Renderer>())
        {
            if (show)
            {
                var block = new MaterialPropertyBlock();
                r.GetPropertyBlock(block);
                Color baseColor = r.sharedMaterial != null && r.sharedMaterial.HasProperty("_BaseColor")
                    ? r.sharedMaterial.GetColor("_BaseColor")
                    : Color.white;
                block.SetColor("_BaseColor", Color.Lerp(baseColor, highlightColor, highlightIntensity));
                r.SetPropertyBlock(block);
            }
            else
            {
                r.SetPropertyBlock(null);
            }
        }
    }

    // ── 버튼 콜백 ────────────────────────────────────────────

    // ── 자동 등록 ─────────────────────────────────────────────

    void RefreshEditableItems()
    {
        var list = new System.Collections.Generic.List<FurnitureEditConfig>();

        // furnitureParent 직계 자식 전부 → 기본 canMove=true (Door는 false)
        if (furnitureParent != null)
            foreach (Transform child in furnitureParent)
            {
                bool isDoor = child.name.IndexOf("Door", System.StringComparison.OrdinalIgnoreCase) >= 0;
                list.Add(new FurnitureEditConfig { target = child.gameObject, canMove = !isDoor, canDesign = true });
            }

        // wallParent 직계 자식 전부 → canMove=false, canDesign=true
        if (wallParent != null)
            foreach (Transform child in wallParent)
                list.Add(new FurnitureEditConfig { target = child.gameObject, canMove = false, canDesign = true });

        editableItems = list.ToArray();
    }

    // ── 방 경계 자동 계산 ─────────────────────────────────────

    void ComputeRoomBoundsFromWalls()
    {
        if (wallParent == null)
        {
                return;
        }

        bool first = true;
        Bounds combined = new Bounds();
        foreach (Transform child in wallParent)
        {
            foreach (var col in child.GetComponentsInChildren<Collider>())
            {
                if (first) { combined = col.bounds; first = false; }
                else combined.Encapsulate(col.bounds);
            }
        }

        if (first) return;

        roomMinX = combined.min.x;
        roomMaxX = combined.max.x;
        roomMinZ = combined.min.z;
        roomMaxZ = combined.max.z;
    }

    // ── 가구 추가 ─────────────────────────────────────────────

    public void OpenAddFurniturePanel()
    {
        if (addFurniturePanel) addFurniturePanel.SetActive(true);
    }

    public void CloseAddFurniturePanel()
    {
        if (addFurniturePanel) addFurniturePanel.SetActive(false);
    }

    /// <summary>가구 추가 패널에서 선택 시 호출. 씬에 배치 후 editableItems에 자동 등록.</summary>
    public void AddFurniture(GameObject prefab)
    {
        if (prefab == null) return;
        var instance = Instantiate(prefab, Vector3.zero, Quaternion.identity);

        var list = new System.Collections.Generic.List<FurnitureEditConfig>(editableItems ?? new FurnitureEditConfig[0]);
        list.Add(new FurnitureEditConfig { target = instance, canMove = true, canDesign = true });
        editableItems = list.ToArray();

        CloseAddFurniturePanel();
    }

    void OnDesignChange()
    {
        if (_selected == null) return;
        DesignSelectUI.Instance?.Open(_selected.name);
    }

    void OnPositionMove()
    {
        if (_selected == null) return;
        _originalPos = _selected.transform.position;
        _originalRot = _selected.transform.rotation;
        _movingMode  = true;
        _dragFingerId = -1;
        _dragOffsetInit = false;   // 새 이동 모드 — 이전 가구의 오프셋이 새지 않도록 리셋

        // ── Rigidbody: physics가 위치 덮어쓰지 못하게 kinematic 전환 ──────
        var rb = _selected.GetComponentInChildren<Rigidbody>();
        if (rb == null) rb = _selected.GetComponent<Rigidbody>();
        if (rb != null) rb.isKinematic = true;

        // ── Animator: 애니메이션이 위치 되돌리지 못하게 비활성화 ───────────
        foreach (var anim in _selected.GetComponentsInChildren<Animator>()) anim.enabled = false;


        var cfg = GetConfig(_selected);
        if (editPopup) editPopup.SetActive(false);
        if (confirmUI) confirmUI.SetActive(true);
    }

    void Confirm()
    {
        _movingMode = false;
        if (confirmUI) confirmUI.SetActive(false);

        // 확정 시점에 그리드 스냅 적용
        if (_selected != null)
        {
            var snapped = SnapToGrid(_selected.transform.position);
            snapped.y = _selected.transform.position.y;
            _selected.transform.position = snapped;
        }

        // TODO: DB 연동 시 주석 해제
        // RoomDataManager.Instance?.Save();
        // FirebaseManager.Instance?.SaveFurniturePosition(_selected.name, _selected.transform.position);

        Deselect();
    }

    void Cancel() => CancelMove();

    void CancelMove()
    {
        if (_selected != null && _movingMode)
        {
            _selected.transform.position = _originalPos;
            _selected.transform.rotation = _originalRot;
        }

        _movingMode    = false;
        _isDragOverlap = false;
        if (confirmUI) confirmUI.SetActive(false);
        Deselect();
    }

    void RotateSelected(float angleDeg)
    {
        if (_selected == null) return;
        _selected.transform.Rotate(Vector3.up, angleDeg, Space.World);
    }

    // ── 드래그 처리 ───────────────────────────────────────────

    void HandleDrag()
    {
        if (_selected == null) return;

        Vector2 inputPos = Vector2.zero;
        bool    began    = false;
        bool    hasInput = false;

        if (Touch.activeTouches.Count > 0)
        {
            foreach (var t in Touch.activeTouches)
            {
                if (t.phase == UnityEngine.InputSystem.TouchPhase.Began)
                { _dragFingerId = t.finger.index; inputPos = t.screenPosition; began = true; hasInput = true; break; }
                if (t.finger.index == _dragFingerId)
                { inputPos = t.screenPosition; hasInput = true; break; }
                // Began 프레임을 버튼 탭이 소비해서 _dragFingerId가 아직 -1이면
                // Moved/Stationary 단계의 첫 손가락을 바로 캡처
                if (_dragFingerId == -1 &&
                    (t.phase == UnityEngine.InputSystem.TouchPhase.Moved ||
                     t.phase == UnityEngine.InputSystem.TouchPhase.Stationary))
                { _dragFingerId = t.finger.index; inputPos = t.screenPosition; hasInput = true; break; }
            }
        }
        else if (Mouse.current != null)
        {
            if (Mouse.current.leftButton.wasPressedThisFrame)
            { inputPos = Mouse.current.position.ReadValue(); began = true; hasInput = true; }
            else if (Mouse.current.leftButton.isPressed)
            { inputPos = Mouse.current.position.ReadValue(); hasInput = true; }
        }

        if (!hasInput) { if (_debugDrag) Debug.Log($"[Drag] {_selected.name} — 입력 없음 (touches={Touch.activeTouches.Count})"); return; }

        Ray ray = _cam.ScreenPointToRay(inputPos);
        // 가구 자신의 Y 높이 기준으로 교차점 계산 (floorY=0 쓰면 카메라 각도 때문에 오프셋 틀어짐)
        float furY = _selected.transform.position.y;
        if (!RaycastAtHeight(ray, furY, out Vector3 worldPos))
        {
            if (_debugDrag) Debug.LogWarning($"[Drag] {_selected.name} — RaycastAtHeight 실패 (furY={furY}, ray.dir.y={ray.direction.y:F3}) → 이동 평면 교차 불가");
            return;
        }

        // began(터치 Began / 마우스 wasPressedThisFrame)이 오지 않아도,
        // 이번 이동 모드에서 오프셋이 아직 안 잡혔으면 첫 유효 프레임에 잡는다.
        // (위치이동 버튼 클릭으로 인해 Began 프레임을 놓치는 경우 대비 — 이전 가구 오프셋 누수 방지)
        if (began || !_dragOffsetInit)
        {
            _dragOffset = _selected.transform.position - new Vector3(worldPos.x, furY, worldPos.z);
            _dragOffsetInit = true;
            if (_debugDrag) Debug.Log($"[Drag] {_selected.name} — 오프셋 설정 began={began} offset={_dragOffset}");
        }

        Vector3 targetPos = new Vector3(worldPos.x + _dragOffset.x, furY, worldPos.z + _dragOffset.z);

        // 벽 통과 방지 — wallParent 자식 콜라이더에 닿으면 해당 축 이동 차단
        targetPos = ClampByWalls(_selected.transform.position, targetPos);

        // Board는 벽에 붙는 가구라 바닥 체크 없이 이동 허용
        // 나머지는 아래에 콜라이더(바닥)가 있어야만 이동
        bool isBoard = _selected.name.IndexOf("Board", System.StringComparison.OrdinalIgnoreCase) >= 0;
        if (!isBoard)
        {
            // 바닥 검사: 가구 위(furY+10)에서 아래로 충분히 길게 레이캐스트.
            // QueryTriggerInteraction.Collide + 자기 자신 콜라이더 제외 → 가구 자신을 "바닥"으로 오인하지 않음.
            Vector3 checkPos = targetPos + Vector3.up * 10f;
            var floorHits = Physics.RaycastAll(checkPos, Vector3.down, 400f, ~0, QueryTriggerInteraction.Collide);
            bool hasFloor = false;
            foreach (var fh in floorHits)
            {
                // 선택된 가구 자신(및 그 자식)의 콜라이더는 바닥으로 치지 않는다.
                if (fh.collider != null && fh.collider.transform.IsChildOf(_selected.transform)) continue;
                hasFloor = true;
                break;
            }

            if (!hasFloor)
            {
                // 바닥을 못 찾아도 이동을 완전히 막지 않는다. (의자/옷장처럼 콜라이더 분포가
                // 달라서 빗나가는 경우, 기존엔 여기서 return 되어 영영 안 움직였음)
                // 경고만 남기고 furY 평면 기준으로 그대로 이동시킨다.
                if (_debugDrag) Debug.LogWarning($"[Drag] {_selected.name} — 바닥 미검출 (checkPos={checkPos}, hits={floorHits.Length}) → 그래도 이동 허용");
            }
        }

        Vector3 before = _selected.transform.position;
        _selected.transform.position = targetPos; // 드래그 중엔 스냅 없이 부드럽게
        Vector3 after = _selected.transform.position;
        // SET한 값과 ACTUAL이 다르면 Static Batching 또는 다른 스크립트가 위치를 덮어쓰는 것
        if (_debugDrag) Debug.Log($"[Drag] {_selected.name} | SET→{targetPos:F1} | ACTUAL:{after:F1} | match={after == targetPos} | isStatic={_selected.isStatic}");
    }

    // ── 바닥 평면 교차 ────────────────────────────────────────

    // ── 벽 충돌 차단 + 가구 겹침 빨간색 ────────────────────────
    // · 문(Door)          → 통과, 색 변화 없음
    // · 가구(furnitureParent 자식) → 통과 허용, 빨간색
    // · 그 외(벽·창문 등) → 이동 차단
    // · X·Z 축 독립 체크  → 벽을 따라 미끄러짐
    Vector3 ClampByWalls(Vector3 from, Vector3 to)
    {
        if (_selected == null) return to;

        Vector3 result = to;

        if (Mathf.Abs(to.x - from.x) > 0.01f)
            if (HitsObstacle(new Vector3(to.x, from.y, from.z)))
                result.x = from.x;

        if (Mathf.Abs(to.z - from.z) > 0.01f)
            if (HitsObstacle(new Vector3(result.x, from.y, to.z)))
                result.z = from.z;

        // 최종 위치에서 가구 겹침 여부 → 빨간색 토글
        bool overlap = OverlapsFurniture(new Vector3(result.x, from.y, result.z));
        if (overlap != _isDragOverlap)
        {
            _isDragOverlap = overlap;
            SetDragHighlightColor(overlap ? Color.red : highlightColor);
        }

        return result;
    }

    /// <summary>벽·고정 장애물에 닿으면 true. editableItems 등록 가구·문은 무시.</summary>
    bool HitsObstacle(Vector3 worldPos)
    {
        Vector3 offset = worldPos - _selected.transform.position;
        foreach (var col in _selected.GetComponentsInChildren<Collider>())
        {
            if (!col.enabled) continue;
            Vector3 center = col.bounds.center + offset;
            Vector3 half   = col.bounds.extents * 0.8f;
            half.y = Mathf.Min(half.y, 1f);
            foreach (var ov in Physics.OverlapBox(center, half, col.transform.rotation, ~0, QueryTriggerInteraction.Collide))
            {
                if (ov == null || ov.transform.IsChildOf(_selected.transform)) continue;
                if (IsDoor(ov)) continue;
                if (IsRegisteredFurniture(ov)) continue; // editableItems 가구 → 통과
                return true; // 그 외 전부 장애물
            }
        }
        return false;
    }

    /// <summary>editableItems에 등록된 다른 가구(문 제외)와 겹치면 true</summary>
    bool OverlapsFurniture(Vector3 worldPos)
    {
        Vector3 offset = worldPos - _selected.transform.position;
        foreach (var col in _selected.GetComponentsInChildren<Collider>())
        {
            if (!col.enabled) continue;
            Vector3 center = col.bounds.center + offset;
            Vector3 half   = col.bounds.extents * 0.8f;
            half.y = Mathf.Min(half.y, 1f);
            foreach (var ov in Physics.OverlapBox(center, half, col.transform.rotation, ~0, QueryTriggerInteraction.Collide))
            {
                if (ov == null || ov.transform.IsChildOf(_selected.transform)) continue;
                if (IsDoor(ov)) continue;
                if (IsRegisteredFurniture(ov)) return true;
            }
        }
        return false;
    }

    /// <summary>이동 가능한 가구(canMove=true)의 콜라이더인지. 벽(canMove=false)은 제외.</summary>
    bool IsRegisteredFurniture(Collider ov)
    {
        if (editableItems == null) return false;
        foreach (var cfg in editableItems)
        {
            if (cfg.target == null || cfg.target == _selected) continue;
            if (!cfg.canMove) continue; // canMove=false = 벽·고정물 → 장애물로 처리
            if (ov.transform.IsChildOf(cfg.target.transform)) return true;
        }
        return false;
    }

    bool IsDoor(Collider ov) =>
        ov.transform.root.name.IndexOf("Door", System.StringComparison.OrdinalIgnoreCase) >= 0 ||
        ov.name.IndexOf("Door", System.StringComparison.OrdinalIgnoreCase) >= 0;

    void SetDragHighlightColor(Color color)
    {
        if (_selected == null) return;
        foreach (var r in _selected.GetComponentsInChildren<Renderer>())
        {
            var block = new MaterialPropertyBlock();
            r.GetPropertyBlock(block);
            Color baseColor = r.sharedMaterial != null && r.sharedMaterial.HasProperty("_BaseColor")
                ? r.sharedMaterial.GetColor("_BaseColor") : Color.white;
            block.SetColor("_BaseColor", Color.Lerp(baseColor, color, highlightIntensity));
            r.SetPropertyBlock(block);
        }
    }

    bool RaycastAtHeight(Ray ray, float height, out Vector3 result)
    {
        float denom = ray.direction.y;
        if (Mathf.Abs(denom) < 0.0001f) { result = Vector3.zero; return false; }
        float t = (height - ray.origin.y) / denom;
        if (t < 0f) { result = Vector3.zero; return false; }
        result = ray.origin + ray.direction * t;
        return true;
    }

    bool RaycastFloorPlane(Ray ray, out Vector3 result)
    {
        // y = floorY 평면과 ray 교차점
        float denom = ray.direction.y;
        if (Mathf.Abs(denom) < 0.0001f) { result = Vector3.zero; return false; }
        float t = (floorY - ray.origin.y) / denom;
        if (t < 0f) { result = Vector3.zero; return false; }
        result = ray.origin + ray.direction * t;
        return true;
    }

    // ── 그리드 스냅 ───────────────────────────────────────────

    Vector3 SnapToGrid(Vector3 pos)
    {
        return new Vector3(
            Mathf.Round(pos.x / gridCellSize) * gridCellSize,
            pos.y,
            Mathf.Round(pos.z / gridCellSize) * gridCellSize);
    }

    // ── 팝업 위치 ─────────────────────────────────────────────

    void PositionPopupAbove(GameObject furniture)
    {
        if (editPopup == null) return;
        var ren = furniture.GetComponentInChildren<Renderer>();
        Vector3 topWorld = ren != null
            ? ren.bounds.center + Vector3.up * ren.bounds.extents.y
            : furniture.transform.position + Vector3.up * 20f;

        Vector3 screenPos = _cam.WorldToScreenPoint(topWorld);
        var rt = editPopup.GetComponent<RectTransform>();
        if (rt) rt.position = screenPos + Vector3.up * 60f;
    }

    // ── 유틸 ─────────────────────────────────────────────────

    public bool IsEditable(GameObject go) => GetConfig(go) != null;

    /// <summary>클릭한 오브젝트가 속한 등록 target을 반환 (CameraController에서 호출)</summary>
    public GameObject GetEditTarget(GameObject go)
    {
        var cfg = GetConfig(go);
        return cfg?.target;
    }

    FurnitureEditConfig GetConfig(GameObject go)
    {
        if (editableItems == null) return null;
        foreach (var cfg in editableItems)
        {
            if (cfg.target == null) continue;
            if (go == cfg.target || go.transform.IsChildOf(cfg.target.transform)) return cfg;
        }
        return null;
    }
}

[System.Serializable]
public class FurnitureEditConfig
{
    public GameObject target;
    public bool       canMove   = true;
    public bool       canDesign = true;
}
