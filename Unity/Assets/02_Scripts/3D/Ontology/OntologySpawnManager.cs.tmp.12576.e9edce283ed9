using System.Collections.Generic;
using UnityEngine;

/// <summary>
/// Ontology 아이템 소환 매니저.
///
/// 사용법:
///   OntologySpawnManager.Instance.Spawn(ontologyItemComponent);
///
/// 소환 규칙:
///   1. 아이템의 홈 위치(transform.position) 주변에 다른 오브젝트가 없으면
///      그 자리에서 SetActive(true).
///   2. 홈 위치가 겹치면 OntologyItem.zone 에 맞는 영역에서
///      랜덤 위치를 골라 이동 후 SetActive(true).
///
/// 겹침 체크 대상:
///   - 이미 활성화된 다른 OntologyItem
///   - furnitureParent 하위 모든 가구 (Collider 기준)
/// </summary>
public class OntologySpawnManager : MonoBehaviour
{
    public static OntologySpawnManager Instance { get; private set; }

    // ── 겹침 ──────────────────────────────────────────────────

    [Header("겹침 체크")]
    [Tooltip("홈 위치로부터 이 반경 안에 다른 오브젝트가 있으면 '겹침'으로 판단")]
    public float overlapRadius = 0.3f;

    [Tooltip("FurnitureParent — 이 안의 모든 가구가 겹침 체크 대상. " +
             "비우면 가구 겹침은 체크하지 않음.")]
    public Transform furnitureParent;

    // ── 랜덤 배치 풀 ──────────────────────────────────────────

    [Header("Floor 구역 (x/z 범위)")]
    [Tooltip("Floor 랜덤 배치 x 범위 (min.x ~ max.x) / z 범위 (min.y ~ max.y)")]
    public Vector2 floorMin = new Vector2(-200f, -100f);
    public Vector2 floorMax = new Vector2( 100f,  200f);

    [Header("TableSurface 구역 (배치 가능 Transform 목록)")]
    [Tooltip("테이블 위 가능한 위치들 — Inspector에서 씬의 Transform 연결")]
    public Transform[] tableSpawnPoints;

    [Header("Wall 구역 (배치 가능 Transform 목록)")]
    [Tooltip("벽 가능한 위치들 — Inspector에서 씬의 Transform 연결")]
    public Transform[] wallSpawnPoints;

    [Header("Ceiling 구역 (배치 가능 Transform 목록)")]
    [Tooltip("천장 가능한 위치들 — Inspector에서 씬의 Transform 연결")]
    public Transform[] ceilingSpawnPoints;

    [Tooltip("랜덤 위치 탐색 최대 시도 횟수 (전부 겹치면 마지막 후보로 배치)")]
    public int maxTries = 20;

    // ── 라이프사이클 ──────────────────────────────────────────

    void Awake()
    {
        Instance = this;
    }

    // ── 공개 API ──────────────────────────────────────────────

    /// <summary>
    /// item 을 소환한다.
    /// 홈 위치가 비어 있으면 그 자리에, 겹치면 zone 내 랜덤 위치에 SetActive(true).
    ///
    /// ── 백엔드에서 불러온 후 호출 예시 ──────────────────────────
    /// var item = ontologyGameObject.GetComponent&lt;OntologyItem&gt;();
    /// OntologySpawnManager.Instance.Spawn(item);
    /// ────────────────────────────────────────────────────────────
    /// </summary>
    public void Spawn(OntologyItem item)
    {
        if (item == null) return;

        Vector3 homePos = item.transform.position;

        if (item.ignoreOverlap || item.zone == OntologyItem.OntologyZone.Ceiling || !IsOccupied(homePos, item))
        {
            item.gameObject.SetActive(true);
            return;
        }

        // 겹침 → 랜덤 위치 탐색
        Vector3 spawnPos = FindFreePosition(item);
        item.transform.position = spawnPos;
        item.gameObject.SetActive(true);
    }

    // ── 내부 로직 ─────────────────────────────────────────────

    /// <summary>pos 주변에 이미 오브젝트가 있는지 확인.</summary>
    bool IsOccupied(Vector3 pos, OntologyItem self)
    {
        // ① 이미 활성화된 다른 OntologyItem 과의 거리 체크 (Physics 불필요)
        foreach (var item in FindObjectsOfType<OntologyItem>())
        {
            if (item == self) continue;
            if (!item.gameObject.activeInHierarchy) continue;
            if (Vector3.Distance(pos, item.transform.position) < overlapRadius)
                return true;
        }

        // ② FurnitureParent 하위 가구 Collider 체크
        if (furnitureParent != null)
        {
            var cols = Physics.OverlapSphere(pos, overlapRadius);
            foreach (var col in cols)
            {
                if (col.transform.IsChildOf(furnitureParent))
                    return true;
            }
        }

        return false;
    }

    /// <summary>item.zone 에 맞는 랜덤 위치를 탐색해 반환.</summary>
    Vector3 FindFreePosition(OntologyItem item)
    {
        Vector3 candidate = Vector3.zero;
        for (int i = 0; i < maxTries; i++)
        {
            candidate = GetRandomCandidate(item.zone);
            if (!IsOccupied(candidate, item))
                return candidate;
        }
        // maxTries 전부 실패 → 마지막 후보 반환
        return candidate;
    }

    /// <summary>zone 에 맞는 랜덤 위치 후보 1개를 반환.</summary>
    Vector3 GetRandomCandidate(OntologyItem.OntologyZone zone)
    {
        switch (zone)
        {
            case OntologyItem.OntologyZone.TableSurface:
                if (tableSpawnPoints != null && tableSpawnPoints.Length > 0)
                    return tableSpawnPoints[Random.Range(0, tableSpawnPoints.Length)].position;
                break;

            case OntologyItem.OntologyZone.Wall:
                if (wallSpawnPoints != null && wallSpawnPoints.Length > 0)
                    return wallSpawnPoints[Random.Range(0, wallSpawnPoints.Length)].position;
                break;

            case OntologyItem.OntologyZone.Ceiling:
                if (ceilingSpawnPoints != null && ceilingSpawnPoints.Length > 0)
                    return ceilingSpawnPoints[Random.Range(0, ceilingSpawnPoints.Length)].position;
                break;

            case OntologyItem.OntologyZone.Floor:
            default:
                float x = Random.Range(floorMin.x, floorMax.x);
                float z = Random.Range(floorMin.y, floorMax.y);  // .y = z 범위
                float y = FurnitureEditController.Instance != null
                        ? FurnitureEditController.Instance.floorY
                        : 0f;
                return new Vector3(x, y, z);
        }

        // tableSpawnPoints / wallSpawnPoints 미설정 시 Floor 로 폴백
        {
            float x = Random.Range(floorMin.x, floorMax.x);
            float z = Random.Range(floorMin.y, floorMax.y);
            float y = FurnitureEditController.Instance != null
                    ? FurnitureEditController.Instance.floorY
                    : 0f;
            return new Vector3(x, y, z);
        }
    }
}
