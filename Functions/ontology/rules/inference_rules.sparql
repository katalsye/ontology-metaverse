# inference_rules.sparql
# SPARQL CONSTRUCT 기반 추론 규칙
# 실행 순서: ontology_engine.py 에서 순서대로 apply_rule() 호출
# 네임스페이스: prod: <http://7team.dev/ontology#>

PREFIX prod: <http://7team.dev/ontology#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# ══════════════════════════════════════════════════════════════════════════════
# Rule 1 — FatigueRisk (시간대별 가중치 적용)
# 수면 6시간 미만 + 카페인 조건:
#   ① 주간(06~21h): 카페 방문 3회 초과
#   ② 야간(22h~):   카페 방문 1회 초과 (위험도 ×2 → 임계값 절반)
# ── 주말 가중치: SPARQL weekday 함수 미지원 → CalendarEvent 기반 추정
#    캘린더 일정 없는 날 = 주말 프록시 (DuckDB 전처리로 보완)
# → prod:FatigueRisk 상태 부여
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: fatigue_risk
CONSTRUCT {
    ?user prod:hasState prod:FatigueRisk .
}
WHERE {
    ?user a prod:User .

    ?user prod:hasSleepData ?sleep .
    ?sleep prod:duration ?dur .
    FILTER (?dur < 6.0)

    {
        # ① 주간 카페인(06~21h): 3회 초과
        {
            SELECT ?user (COUNT(?loc) AS ?dayCafCnt)
            WHERE {
                ?user prod:hasLocation ?loc .
                ?loc  prod:placeType "cafe" ;
                      prod:visitTime  ?vt .
                BIND (HOURS(?vt) AS ?h)
                FILTER (?h >= 6 && ?h < 22)
            }
            GROUP BY ?user
        }
        FILTER (?dayCafCnt > 2)
    }
    UNION
    {
        # ② 야간 카페인(22h~): 1회 초과 (가중치 2배)
        {
            SELECT ?user (COUNT(?loc) AS ?nightCafCnt)
            WHERE {
                ?user prod:hasLocation ?loc .
                ?loc  prod:placeType "cafe" ;
                      prod:visitTime  ?vt .
                BIND (HOURS(?vt) AS ?h)
                FILTER (?h >= 22)
            }
            GROUP BY ?user
        }
        FILTER (?nightCafCnt > 1)
    }
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 2 — BurnoutWarning + 삶 개선형 퀘스트
# prod:FatigueRisk 상태 + 운동 퀘스트 미완료 3일 이상
# → prod:BurnoutWarning 생성, 스트레칭 퀘스트 생성
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: burnout_warning
CONSTRUCT {
    ?user prod:hasState prod:BurnoutWarning .
    _:q   a prod:Quest ;
          prod:title "가벼운 스트레칭 10분" ;
          prod:questType "삶 개선형" ;
          prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    ?user prod:hasState prod:FatigueRisk .

    # 운동 퀘스트 미완료 3건 이상
    {
        SELECT ?user (COUNT(?q) AS ?pendingCnt)
        WHERE {
            ?user prod:receivesQuest ?q .
            ?q    prod:questType "운동" ;
                  prod:isCompleted false .
        }
        GROUP BY ?user
    }
    FILTER (?pendingCnt >= 3)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 3 — SedentaryPattern + 산책 퀘스트 (연속성 체크 강화)
# 걸음수 3000보 미만 3일 연속 — 날짜 간격 P1D 검증
# ── 단순 COUNT(≥3) → 3-way 날짜 조인으로 교체
# ── 각 날짜 간격이 정확히 1일(P1D)인지 xsd:duration으로 비교
# ── 월 경계(예: 4/30→5/1) 케이스는 DuckDB 전처리가 보완
# → prod:SedentaryPattern, "30분 산책하기" 퀘스트 생성
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: sedentary_pattern
CONSTRUCT {
    ?user prod:hasState prod:SedentaryPattern .
    _:q   a prod:Quest ;
          prod:title "30분 산책하기" ;
          prod:questType "삶 개선형" ;
          prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    ?user a prod:User .

    # 3-way 조인: 걸음수 3000 미만인 StepCount 3개 선택
    ?user prod:hasStepCount ?s1, ?s2, ?s3 .
    FILTER (?s1 != ?s2 && ?s1 != ?s3 && ?s2 != ?s3)

    ?s1 prod:count ?c1 ; prod:date ?d1 .
    ?s2 prod:count ?c2 ; prod:date ?d2 .
    ?s3 prod:count ?c3 ; prod:date ?d3 .

    FILTER (?c1 < 3000 && ?c2 < 3000 && ?c3 < 3000)

    # 날짜 순서 고정 (STR 비교 — ISO 형식 xsd:date 는 사전순 = 시간순)
    FILTER (STR(?d1) < STR(?d2) && STR(?d2) < STR(?d3))

    # 연속성: 각 날짜 간격이 정확히 1일(P1D)
    BIND ((?d2 - ?d1) AS ?gap1)
    BIND ((?d3 - ?d2) AS ?gap2)
    FILTER (?gap1 = "P1D"^^xsd:duration && ?gap2 = "P1D"^^xsd:duration)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 4 — PlaceHabit + RoomObject 추가
# 같은 장소 주 3회 이상 방문
# → prod:PlaceHabit, room_objects에 해당 장소 관련 오브젝트 추가
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: place_habit
CONSTRUCT {
    ?user prod:hasState prod:PlaceHabit .
    _:obj a prod:RoomObject ;
          prod:objectType ?place ;
          prod:inferredFrom "PlaceHabit" ;
          prod:inferredFromConcept prod:PlaceHabit ;
          prod:positionX 0.0 ;
          prod:positionY 0.0 ;
          prod:positionZ 0.0 .
    ?user prod:hasRoomObject _:obj .
}
WHERE {
    ?user a prod:User .

    {
        SELECT ?user ?place (COUNT(?loc) AS ?visitCnt)
        WHERE {
            ?user prod:hasLocation ?loc .
            ?loc  prod:placeName   ?place .
        }
        GROUP BY ?user ?place
    }
    FILTER (?visitCnt >= 3)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 5 — 카페인 → 수면 질 저하 인과 추론 + 퀘스트
# 카페인 섭취 오후 6시 이후 + 수면질 60 미만
# → "오후엔 디카페인 어때요?" 퀘스트 생성
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: late_caffeine_sleep_quality
CONSTRUCT {
    _:q a prod:Quest ;
        prod:title "오후엔 디카페인 어때요?" ;
        prod:questType "삶 개선형" ;
        prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    ?user a prod:User .

    # 수면질 60 미만
    ?user prod:hasSleepData ?sleep .
    ?sleep prod:quality ?qual .
    FILTER (?qual < 60)

    # 오후 6시(18:00) 이후 카페 방문 기록
    ?user prod:hasLocation ?loc .
    ?loc  prod:placeType  "cafe" ;
          prod:visitTime  ?vt .
    BIND(HOURS(?vt) AS ?h)
    FILTER (?h >= 18)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 6 — 빈 노드 감지 → 데이터 보완형 퀘스트
# 방문 장소는 있는데 동행자(companion) 정보 없음
# → "오늘 [장소] 누구랑 갔어?" 퀘스트 생성
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: missing_companion
CONSTRUCT {
    _:q a prod:Quest ;
        prod:title ?questTitle ;
        prod:questType "데이터 보완형" ;
        prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    ?user a prod:User .

    ?user prod:hasLocation ?loc .
    ?loc  prod:placeName ?place .

    # companion 속성이 없는 위치 노드만 선택
    FILTER NOT EXISTS { ?loc prod:companion ?anyone }

    BIND(CONCAT("오늘 ", ?place, " 누구랑 갔어?") AS ?questTitle)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 7 — IndoorDayPattern (계절/날씨 가중치 반영)
# 조건 A: 비오는 날(rain 포함) + 외출 2곳 미만
# 조건 B: 겨울(12·1·2월) + 외출 2곳 미만 (계절 가중치)
# ── UNION으로 두 조건을 병합 — 어느 하나라도 충족 시 IndoorDayPattern 부여
# ── 맑은 날 실내 패턴은 Rule 14(sunny_indoor_quest)에서 별도 강화 퀘스트 생성
# → prod:IndoorDayPattern 상태 부여
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: indoor_day_pattern
CONSTRUCT {
    ?user prod:hasState prod:IndoorDayPattern .
}
WHERE {
    ?user a prod:User .
    ?user prod:hasWeather ?w .
    ?w    prod:recordedAt ?recAt .

    {
        # 조건 A: 비오는 날씨
        ?w prod:condition ?cond .
        FILTER (CONTAINS(LCASE(STR(?cond)), "rain"))
    }
    UNION
    {
        # 조건 B: 겨울(12월·1월·2월) — 계절적 실내 성향 가중
        BIND (MONTH(?recAt) AS ?mon)
        FILTER (?mon = 12 || ?mon = 1 || ?mon = 2)
    }

    # 공통 조건: 집 외 방문 장소 2곳 미만
    {
        SELECT ?user (COUNT(?loc) AS ?outCnt)
        WHERE {
            ?user prod:hasLocation ?loc .
            ?loc  prod:placeName   ?place .
            FILTER (
                !CONTAINS(LCASE(STR(?place)), "home") &&
                !CONTAINS(LCASE(STR(?place)), "집")
            )
        }
        GROUP BY ?user
    }
    FILTER (?outCnt < 2)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 14 — SunnyIndoorQuest
# IndoorDayPattern 상태 + 맑은 날씨(sun/clear)
# → 더 강한 산책 퀘스트 생성
# ── 맑은 날 실내 패턴은 기회 손실이므로 퀘스트 문구 강화
# ── Rule 7 이후 실행 필수 (IndoorDayPattern 선행 의존)
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: sunny_indoor_quest
CONSTRUCT {
    _:q a prod:Quest ;
        prod:title "날씨가 맑아요! 지금 딱 산책하기 좋아요" ;
        prod:questType "삶 개선형" ;
        prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    # Rule 7 결과에 의존 — RULE_ORDER에서 indoor_day_pattern 직후 실행
    ?user prod:hasState prod:IndoorDayPattern .

    ?user prod:hasWeather ?w .
    ?w    prod:condition  ?cond .
    FILTER (
        CONTAINS(LCASE(STR(?cond)), "sun") ||
        CONTAINS(LCASE(STR(?cond)), "clear")
    )
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 8 — Routine
# 같은 시간대(hour) 일정이 주 3회 이상
# → prod:Routine 상태 부여, routineHour 기록
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: routine_detection
CONSTRUCT {
    ?user prod:hasState prod:Routine .
    _:r   a prod:Routine ;
          prod:routineHour ?hour .
    ?user prod:hasRoomObject _:r .
}
WHERE {
    ?user a prod:User .

    {
        SELECT ?user (HOURS(?st) AS ?hour) (COUNT(?evt) AS ?evtCnt)
        WHERE {
            ?user prod:hasCalendarEvent ?evt .
            ?evt  prod:startTime        ?st .
        }
        GROUP BY ?user (HOURS(?st))
    }
    FILTER (?evtCnt >= 3)
}

# ══════════════════════════════════════════════════════════════════════════════
# Rule 9 — MusicMood
# 특정 장르 하루 총 청취 120분(2시간) 이상
# → prod:MusicMood 상태 부여, moodGenre 기록
# ══════════════════════════════════════════════════════════════════════════════
# RULE_ID: music_mood
CONSTRUCT {
    ?user prod:hasState prod:MusicMood .
    _:mm  a prod:MusicMood ;
          prod:moodGenre ?genre .
}
WHERE {
    ?user a prod:User .

    {
        SELECT ?user ?genre (SUM(?dur) AS ?totalMin)
        WHERE {
            ?user prod:listensTo     ?ml .
            ?ml   prod:genre         ?genre ;
                  prod:listenDuration ?dur .
        }
        GROUP BY ?user ?genre
    }
    FILTER (?totalMin >= 120)
}

# ══════════════════════════════════════════════════════════════════════════════
# ── 다단계 인과 추론 체인 (Rules 10–13) ──────────────────────────────────────
#
#  [카페인 오후 섭취]
#       ↓ Rule 10
#  SleepQualityImpaired
#       ↓ Rule 11
#  ExerciseSkipped
#       ↓ Rule 12
#  WeeklyActivityLow
#       ↓ Rule 13
#  BurnoutWarning + 퀘스트
#
# 각 규칙은 이전 단계의 hasState 결과에 의존.
# RULE_ORDER에서 10→11→12→13 순서 고정 필수.
# ══════════════════════════════════════════════════════════════════════════════

# ── Rule 10 — SleepQualityImpaired ───────────────────────────────────────────
# 카페인 섭취 오후 6시 이후 + 수면 질 60 미만
# → prod:SleepQualityImpaired (Rule 11의 선행 조건)
# RULE_ID: causal_sleep_impaired
CONSTRUCT {
    ?user prod:hasState prod:SleepQualityImpaired .
}
WHERE {
    ?user a prod:User .

    # 오후 6시 이후 카페 방문 (카페인 섭취 프록시)
    ?user prod:hasLocation ?loc .
    ?loc  prod:placeType  "cafe" ;
          prod:visitTime  ?vt .
    BIND(HOURS(?vt) AS ?h)
    FILTER (?h >= 18)

    # 수면 질 60 미만
    ?user prod:hasSleepData ?sleep .
    ?sleep prod:quality ?qual .
    FILTER (?qual < 60)
}

# ── Rule 11 — ExerciseSkipped ─────────────────────────────────────────────────
# SleepQualityImpaired 상태 + 운동 Activity 기록 없음
# → prod:ExerciseSkipped (Rule 12의 선행 조건)
# RULE_ID: causal_exercise_skipped
CONSTRUCT {
    ?user prod:hasState prod:ExerciseSkipped .
}
WHERE {
    # Rule 10 결과에 의존
    ?user prod:hasState prod:SleepQualityImpaired .

    # 운동 Activity 기록이 없는 경우
    FILTER NOT EXISTS {
        ?user prod:hasActivity ?act .
        ?act  prod:activityType ?atype .
        FILTER (
            CONTAINS(LCASE(STR(?atype)), "운동") ||
            CONTAINS(LCASE(STR(?atype)), "exercise") ||
            CONTAINS(LCASE(STR(?atype)), "workout")
        )
    }
}

# ── Rule 12 — WeeklyActivityLow ──────────────────────────────────────────────
# ExerciseSkipped 상태 + 걸음수 3000 미만 3일 이상 (주간 활동량 저하 프록시)
# → prod:WeeklyActivityLow (Rule 13의 선행 조건)
# RULE_ID: causal_weekly_activity_low
CONSTRUCT {
    ?user prod:hasState prod:WeeklyActivityLow .
}
WHERE {
    # Rule 11 결과에 의존
    ?user prod:hasState prod:ExerciseSkipped .

    {
        SELECT ?user (COUNT(?s) AS ?lowDayCnt)
        WHERE {
            ?user prod:hasStepCount ?s .
            ?s    prod:count ?cnt .
            FILTER (?cnt < 3000)
        }
        GROUP BY ?user
    }
    FILTER (?lowDayCnt >= 3)
}

# ── Rule 13 — BurnoutWarning (인과 체인 종점) ─────────────────────────────────
# WeeklyActivityLow 상태
# → prod:BurnoutWarning + 삶 개선형 퀘스트
# (Rule 2의 BurnoutWarning과 다른 인과 경로 — 카페인→수면→운동→활동량)
# RULE_ID: causal_burnout_from_chain
CONSTRUCT {
    ?user prod:hasState prod:BurnoutWarning .
    _:q   a prod:Quest ;
          prod:title "이번 주 활동량이 많이 줄었어요. 짧은 산책부터 시작해볼까요?" ;
          prod:questType "삶 개선형" ;
          prod:isCompleted false .
    ?user prod:receivesQuest _:q .
}
WHERE {
    # Rule 12 결과에 의존
    ?user prod:hasState prod:WeeklyActivityLow .
}
