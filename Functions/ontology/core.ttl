@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prod: <http://7team.dev/ontology#> .

# ─── Ontology Declaration ───────────────────────────────────────────────────

<http://7team.dev/ontology>
    a owl:Ontology ;
    rdfs:label "Personal Productivity Ontology" ;
    rdfs:comment "7조 종합설계 — 온톨로지 기반 개인 생산성 향상 플랫폼" .

# ─── Classes ────────────────────────────────────────────────────────────────

prod:User a owl:Class ;
    rdfs:label "User" .

prod:SleepData a owl:Class ;
    rdfs:label "SleepData" .

prod:StepCount a owl:Class ;
    rdfs:label "StepCount" .

prod:AppUsage a owl:Class ;
    rdfs:label "AppUsage" .

prod:GalleryPhoto a owl:Class ;
    rdfs:label "GalleryPhoto" .

prod:Location a owl:Class ;
    rdfs:label "Location" .

prod:Activity a owl:Class ;
    rdfs:label "Activity" .

prod:Quest a owl:Class ;
    rdfs:label "Quest" .

prod:Reward a owl:Class ;
    rdfs:label "Reward" .

prod:Persona a owl:Class ;
    rdfs:label "Persona" .

prod:RoomObject a owl:Class ;
    rdfs:label "RoomObject" .

# Inferred state classes
prod:FatigueRisk a owl:Class ;
    rdfs:label "FatigueRisk" .

prod:BurnoutWarning a owl:Class ;
    rdfs:label "BurnoutWarning" .

prod:SedentaryPattern a owl:Class ;
    rdfs:label "SedentaryPattern" .

prod:PlaceHabit a owl:Class ;
    rdfs:label "PlaceHabit" .

# ─── Object Properties ──────────────────────────────────────────────────────

prod:hasSleepData a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:SleepData .

prod:hasStepCount a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:StepCount .

prod:hasAppUsage a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:AppUsage .

prod:hasGalleryPhoto a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:GalleryPhoto .

prod:hasLocation a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:Location .

prod:hasActivity a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:Activity .

prod:hasPersona a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:Persona .

prod:receivesQuest a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:Quest .

prod:triggeredBy a owl:ObjectProperty ;
    rdfs:domain prod:Activity ;
    rdfs:range  prod:Quest .

prod:gives a owl:ObjectProperty ;
    rdfs:domain prod:Quest ;
    rdfs:range  prod:Reward .

prod:hasState a owl:ObjectProperty ;
    rdfs:domain prod:User .

prod:hasRoomObject a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:RoomObject .

prod:inferredFromConcept a owl:ObjectProperty ;
    rdfs:domain prod:RoomObject .

# ─── Datatype Properties — User ─────────────────────────────────────────────

prod:uid a owl:DatatypeProperty ;
    rdfs:domain prod:User ;
    rdfs:range  xsd:string .

prod:name a owl:DatatypeProperty ;
    rdfs:domain prod:User ;
    rdfs:range  xsd:string .

# ─── Datatype Properties — SleepData ────────────────────────────────────────

prod:duration a owl:DatatypeProperty ;
    rdfs:domain prod:SleepData ;
    rdfs:range  xsd:float .

prod:quality a owl:DatatypeProperty ;
    rdfs:domain prod:SleepData ;
    rdfs:range  xsd:integer .

prod:deepSleepRatio a owl:DatatypeProperty ;
    rdfs:domain prod:SleepData ;
    rdfs:range  xsd:float .

prod:timestamp a owl:DatatypeProperty ;
    rdfs:range  xsd:dateTime .

# ─── Datatype Properties — StepCount ────────────────────────────────────────

prod:count a owl:DatatypeProperty ;
    rdfs:domain prod:StepCount ;
    rdfs:range  xsd:integer .

prod:date a owl:DatatypeProperty ;
    rdfs:range  xsd:date .

# ─── Datatype Properties — AppUsage ─────────────────────────────────────────

prod:appName a owl:DatatypeProperty ;
    rdfs:domain prod:AppUsage ;
    rdfs:range  xsd:string .

prod:usageDuration a owl:DatatypeProperty ;
    rdfs:domain prod:AppUsage ;
    rdfs:range  xsd:integer .

# ─── Datatype Properties — GalleryPhoto ─────────────────────────────────────

prod:latitude a owl:DatatypeProperty ;
    rdfs:range  xsd:float .

prod:longitude a owl:DatatypeProperty ;
    rdfs:range  xsd:float .

prod:foodType a owl:DatatypeProperty ;
    rdfs:domain prod:GalleryPhoto ;
    rdfs:range  xsd:string .

prod:placeType a owl:DatatypeProperty ;
    rdfs:range  xsd:string .

prod:analyzedBy a owl:DatatypeProperty ;
    rdfs:domain prod:GalleryPhoto ;
    rdfs:range  xsd:string .

# ─── Datatype Properties — Location ─────────────────────────────────────────

prod:placeName a owl:DatatypeProperty ;
    rdfs:domain prod:Location ;
    rdfs:range  xsd:string .

prod:visitTime a owl:DatatypeProperty ;
    rdfs:domain prod:Location ;
    rdfs:range  xsd:dateTime .

prod:visitCount a owl:DatatypeProperty ;
    rdfs:domain prod:Location ;
    rdfs:range  xsd:integer .

prod:companion a owl:DatatypeProperty ;
    rdfs:domain prod:Location ;
    rdfs:range  xsd:string .

# ─── Datatype Properties — Activity ─────────────────────────────────────────

prod:activityType a owl:DatatypeProperty ;
    rdfs:domain prod:Activity ;
    rdfs:range  xsd:string .

# ─── Datatype Properties — Quest ─────────────────────────────────────────────

prod:title a owl:DatatypeProperty ;
    rdfs:domain prod:Quest ;
    rdfs:range  xsd:string .

prod:questType a owl:DatatypeProperty ;
    rdfs:domain prod:Quest ;
    rdfs:range  xsd:string .

prod:isCompleted a owl:DatatypeProperty ;
    rdfs:domain prod:Quest ;
    rdfs:range  xsd:boolean .

prod:createdAt a owl:DatatypeProperty ;
    rdfs:domain prod:Quest ;
    rdfs:range  xsd:dateTime .

# ─── Datatype Properties — Reward ────────────────────────────────────────────

prod:amount a owl:DatatypeProperty ;
    rdfs:domain prod:Reward ;
    rdfs:range  xsd:integer .

prod:rewardType a owl:DatatypeProperty ;
    rdfs:domain prod:Reward ;
    rdfs:range  xsd:string .

# ─── Datatype Properties — Persona ───────────────────────────────────────────

prod:energyType a owl:DatatypeProperty ;
    rdfs:domain prod:Persona ;
    rdfs:range  xsd:string .

prod:socialPreference a owl:DatatypeProperty ;
    rdfs:domain prod:Persona ;
    rdfs:range  xsd:string .

prod:lifePattern a owl:DatatypeProperty ;
    rdfs:domain prod:Persona ;
    rdfs:range  xsd:string .

prod:updatedAt a owl:DatatypeProperty ;
    rdfs:domain prod:Persona ;
    rdfs:range  xsd:dateTime .

# ─── Datatype Properties — RoomObject ────────────────────────────────────────

prod:objectType a owl:DatatypeProperty ;
    rdfs:domain prod:RoomObject ;
    rdfs:range  xsd:string .

prod:positionX a owl:DatatypeProperty ;
    rdfs:domain prod:RoomObject ;
    rdfs:range  xsd:float .

prod:positionY a owl:DatatypeProperty ;
    rdfs:domain prod:RoomObject ;
    rdfs:range  xsd:float .

prod:positionZ a owl:DatatypeProperty ;
    rdfs:domain prod:RoomObject ;
    rdfs:range  xsd:float .

prod:inferredFrom a owl:DatatypeProperty ;
    rdfs:domain prod:RoomObject ;
    rdfs:range  xsd:string .

# inferredFromConcept: RoomObject → 유래 개념 URI (PlaceHabit, Persona 등)
# inferredFrom(string)과 병행 — 엔진이 두 속성 모두 기록

# ─── Classes — 확장 데이터 소스 ─────────────────────────────────────────────

prod:MusicListening a owl:Class ;
    rdfs:label "MusicListening" .

prod:CalendarEvent a owl:Class ;
    rdfs:label "CalendarEvent" .

prod:Weather a owl:Class ;
    rdfs:label "Weather" .

# Inferred state classes — 확장
prod:IndoorDayPattern a owl:Class ;
    rdfs:label "IndoorDayPattern" .

prod:Routine a owl:Class ;
    rdfs:label "Routine" .

prod:MusicMood a owl:Class ;
    rdfs:label "MusicMood" .

# 다단계 인과 체인 중간 상태 클래스
prod:SleepQualityImpaired a owl:Class ;
    rdfs:label "SleepQualityImpaired" .

prod:ExerciseSkipped a owl:Class ;
    rdfs:label "ExerciseSkipped" .

prod:WeeklyActivityLow a owl:Class ;
    rdfs:label "WeeklyActivityLow" .

# ─── Object Properties — 확장 ───────────────────────────────────────────────

prod:listensTo a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:MusicListening .

prod:hasCalendarEvent a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:CalendarEvent .

prod:hasWeather a owl:ObjectProperty ;
    rdfs:domain prod:User ;
    rdfs:range  prod:Weather .

# ─── Datatype Properties — MusicListening ───────────────────────────────────

prod:trackName a owl:DatatypeProperty ;
    rdfs:domain prod:MusicListening ;
    rdfs:range  xsd:string .

prod:artist a owl:DatatypeProperty ;
    rdfs:domain prod:MusicListening ;
    rdfs:range  xsd:string .

prod:genre a owl:DatatypeProperty ;
    rdfs:domain prod:MusicListening ;
    rdfs:range  xsd:string .

prod:playedAt a owl:DatatypeProperty ;
    rdfs:domain prod:MusicListening ;
    rdfs:range  xsd:dateTime .

prod:listenDuration a owl:DatatypeProperty ;
    rdfs:domain prod:MusicListening ;
    rdfs:range  xsd:integer .

# ─── Datatype Properties — CalendarEvent ────────────────────────────────────

prod:eventTitle a owl:DatatypeProperty ;
    rdfs:domain prod:CalendarEvent ;
    rdfs:range  xsd:string .

prod:startTime a owl:DatatypeProperty ;
    rdfs:domain prod:CalendarEvent ;
    rdfs:range  xsd:dateTime .

prod:endTime a owl:DatatypeProperty ;
    rdfs:domain prod:CalendarEvent ;
    rdfs:range  xsd:dateTime .

prod:isRecurring a owl:DatatypeProperty ;
    rdfs:domain prod:CalendarEvent ;
    rdfs:range  xsd:boolean .

# ─── Datatype Properties — Weather ──────────────────────────────────────────

prod:temperature a owl:DatatypeProperty ;
    rdfs:domain prod:Weather ;
    rdfs:range  xsd:float .

prod:condition a owl:DatatypeProperty ;
    rdfs:domain prod:Weather ;
    rdfs:range  xsd:string .

prod:humidity a owl:DatatypeProperty ;
    rdfs:domain prod:Weather ;
    rdfs:range  xsd:float .

prod:recordedAt a owl:DatatypeProperty ;
    rdfs:domain prod:Weather ;
    rdfs:range  xsd:dateTime .

# ─── Datatype Properties — Routine / MusicMood ──────────────────────────────

prod:routineHour a owl:DatatypeProperty ;
    rdfs:domain prod:Routine ;
    rdfs:range  xsd:integer .

prod:moodGenre a owl:DatatypeProperty ;
    rdfs:domain prod:MusicMood ;
    rdfs:range  xsd:string .

# ─── OWL 제약조건 ────────────────────────────────────────────────────────────

# ── 클래스 분리 선언 (owl:disjointWith) ──────────────────────────────────────

prod:SleepData      owl:disjointWith prod:StepCount .
prod:Quest          owl:disjointWith prod:Reward .
prod:FatigueRisk    owl:disjointWith prod:BurnoutWarning .
prod:CalendarEvent  owl:disjointWith prod:MusicListening .

# ── 데이터 범위 제약 (owl:allValuesFrom + owl:withRestrictions) ───────────────

# SleepData.duration: 0.0 ~ 24.0 (시간)
prod:SleepData rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:duration ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions (
            [ xsd:minInclusive "0.0"^^xsd:float  ]
            [ xsd:maxInclusive "24.0"^^xsd:float ]
        )
    ]
] .

# SleepData.quality: 0 ~ 100 (정수)
prod:SleepData rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:quality ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions (
            [ xsd:minInclusive "0"^^xsd:integer   ]
            [ xsd:maxInclusive "100"^^xsd:integer ]
        )
    ]
] .

# StepCount.count: 0 이상 (비음수)
prod:StepCount rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:count ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions (
            [ xsd:minInclusive "0"^^xsd:integer ]
        )
    ]
] .

# Weather.temperature: -50 ~ 60 (섭씨)
prod:Weather rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:temperature ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions (
            [ xsd:minInclusive "-50.0"^^xsd:float ]
            [ xsd:maxInclusive "60.0"^^xsd:float  ]
        )
    ]
] .

# Weather.humidity: 0 ~ 100 (퍼센트)
prod:Weather rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:humidity ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions (
            [ xsd:minInclusive "0.0"^^xsd:float   ]
            [ xsd:maxInclusive "100.0"^^xsd:float ]
        )
    ]
] .

# ── 필수 속성 선언 (owl:minCardinality 1) ────────────────────────────────────

# User는 반드시 uid를 가져야 함
prod:User rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:uid ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Quest는 반드시 title을 가져야 함
prod:Quest rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:title ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# SleepData는 반드시 duration을 가져야 함
prod:SleepData rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prod:duration ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .
